<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <Title>IntegrationHub</Title>
        <Description>Interface zum Host</Description>
        <Company>Element Logic GmbH</Company>
        <Product>IntegrationHub</Product>
        <Copyright>Copyright © 2021</Copyright>
        <Trademark>eController</Trademark>

        <TargetFramework>net9.0</TargetFramework>
        <RuntimeIdentifiers>win-x64;linux-x64;linux-musl-x64;linux-arm64;linux-musl-arm64</RuntimeIdentifiers>
        <PublishTrimmed>false</PublishTrimmed>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <!-- Container Configuration -->
    <PropertyGroup>
        <ContainerRepository>ehub</ContainerRepository>
        <ContainerFamily>alpine</ContainerFamily>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="eController.Util" />
        <PackageReference Include="eController.WebUI.Library" />
        <PackageReference Include="ElementLogic.Configuration" />
        <PackageReference Include="ElementLogic.ConfigurationManager.Library" />
        <PackageReference Include="ElementLogic.MessageBusClient" />
        <PackageReference Include="ElUI.ComponentLib" />
        <PackageReference Include="eMessenger" />
        <PackageReference Include="ePlugin.Engine" />
        <PackageReference Include="eScheduler.Library" />
        <PackageReference Include="eScheduler.UI" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <!-- Required for version conflict resolution. Not directly used in this project -->
        <!--<PackageReference Include="Microsoft.CodeAnalysis.Common">
            <TreatAsUsed>true</TreatAsUsed>
        </PackageReference>-->
        <PackageReference Include="Microsoft.Data.SqlClient" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" />
        <!--<PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>-->
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
        <PackageReference Include="Microsoft.Extensions.Http.Polly" />
        <PackageReference Include="NLog" />
        <PackageReference Include="NLog.Database" />
        <PackageReference Include="NLog.Targets.Loki" />
        <PackageReference Include="OpenTelemetry" />
        <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="Polly" />
        <PackageReference Include="Riok.Mapperly" PrivateAssets="all" ExcludeAssets="runtime">
            <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
        <PackageReference Include="Swashbuckle.AspNetCore" />
        <PackageReference Include="Yarp.ReverseProxy" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\eHub.Manager\eHub.Manager.csproj" />
        <ProjectReference Include="..\eHub.Contracts\eHub.Contracts.csproj" />
        <ProjectReference Include="..\eHub.PlugIn\eHub.PlugIn.csproj" />
        <ProjectReference Include="..\eHub.UI\eHub.UI.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="appsettings.*.json">
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        </Content>
        <Content Update="NLog.*.config">
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup Condition="'$(PublishTarget)' == 'Container'">
        <Content Update="appsettings.Container.json" CopyToPublishDirectory="Always" />
        <Content Update="NLog.Container.config" CopyToPublishDirectory="Always" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="NLog.config">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="eHub.Tests" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Databases\" />
    </ItemGroup>
</Project>
