<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<PropertyGroup>
		<eUtilFeatures>$(eUtilFeatures),CollectionExtensions,ObjUtil</eUtilFeatures>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="eController.Util.Embed">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\eHub.PlugIn\eHub.PlugIn.csproj" />
	</ItemGroup>

</Project>
