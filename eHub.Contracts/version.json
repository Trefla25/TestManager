{
  "$schema": "https://raw.githubusercontent.com/dotnet/Nerdbank.GitVersioning/main/src/NerdBank.GitVersioning/version.schema.json",
  "version": "3.6.19",
  "publicReleaseRefSpec": [
    "^refs/heads/(master|main|\\w+-force-deploy)$"
  ],
  "release": {
    "tagName": "ehub_contracts/v{version}",
    "branchName": "ehub_contracts/v{version}",
    "firstUnstableTag": "dev"
  },
  "pathFilters": [
    "/eController.IntegrationHub.Contracts",
    "/eController.IntegrationHub.PlugIn"
  ]
}