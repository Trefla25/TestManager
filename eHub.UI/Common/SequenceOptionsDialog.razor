@using eController.WebUI.Utility.DynamicComponent
@inherits FrameworkComponent

<MudDialog ClassContent="py-0">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.FormatListNumbered" Class="mr-3" />
            @Localizer["Sequence"]
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudCard Outlined="true">
            <MudCardContent>
                <div class="d-flex flex-column">
                    <MudButton Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.DataArray"
                               Size="Size.Large"
                               Color="Color.Primary"
                               OnClick="OpenSequenceIntervalDialog"
                               Class="rounded-pill mud-width-full mb-1">
                        @Localizer["SequenceInterval"]
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.PlaylistPlay"
                               Size="Size.Large"
                               Color="Color.Primary"
                               OnClick="RunSequence"
                               Disabled="!SelectedPackets.Any(p => p.CanResend)"
                               Class="rounded-pill mud-width-full mb-1">
                        @Localizer["RunSequence"]
                    </MudButton>

                    <MudButton Variant="Variant.Filled"
                               StartIcon="@Icons.Material.Filled.DeleteSweep"
                               Size="Size.Large"
                               Color="Color.Primary"
                               OnClick="DeleteSequence"
                               Disabled="!SelectedPackets.Any()"
                               Class="rounded-pill mud-width-full mb-1">
                        @Localizer["DeleteSequence"]
                    </MudButton>
                </div>

            </MudCardContent>
        </MudCard>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Localizer["Cancel"]</MudButton>
    </DialogActions>
</MudDialog>